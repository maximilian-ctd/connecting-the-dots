  .ci-glow-blue::before { background: radial-gradient(circle at top, rgba(148, 211, 236, 0.35), transparent 55%); }
  .ci-glow-purple::before { background: radial-gradient(circle at top, rgba(220, 180, 255, 0.35), transparent 55%); }

  .ci-badge {
