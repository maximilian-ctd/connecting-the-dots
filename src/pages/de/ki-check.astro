  }
  .ci-card:hover .ci-badge { transform: scale(1.1) rotate(-4deg); }
  @media (prefers-reduced-motion: reduce) {
    .ci-card, .ci-card:hover, .ci-badge, .ci-card:hover .ci-badge { transition: none; transform: none; }
  }

  /* Scroll-Einblendungen (schnell). Ohne JS bleibt alles sichtbar. */
  :global(html.reveal-js) [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    will-change: opacity, transform;
  }
  :global(html.reveal-js) [data-reveal].reveal-in { opacity: 1; transform: none; }
  :global(html.reveal-js) [data-reveal][data-delay="1"] { transition-delay: 0.05s; }
  :global(html.reveal-js) [data-reveal][data-delay="2"] { transition-delay: 0.1s; }
  :global(html.reveal-js) [data-reveal][data-delay="3"] { transition-delay: 0.15s; }

  /* Bewegte Akzent-Flächen im Hero */
  .blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(70px);
    pointer-events: none;
    z-index: 0;
  }
  .blob-a {
    width: 22rem; height: 22rem;
    top: -4rem; right: -3rem;
    background: rgba(123, 224, 183, 0.28);
    animation: blob-float-a 14s ease-in-out infinite;
  }
  .blob-b {
    width: 18rem; height: 18rem;
    bottom: -5rem; left: -3rem;
    background: rgba(123, 224, 183, 0.18);
    animation: blob-float-b 18s ease-in-out infinite;
  }
  @keyframes blob-float-a {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-24px, 28px) scale(1.12); }
  }
  @keyframes blob-float-b {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(28px, -22px) scale(1.1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob { animation: none; }
    :global(html.reveal-js) [data-reveal] { transition: none; }
  }
</style>
