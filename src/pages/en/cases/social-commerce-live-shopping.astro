---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Footer from '../../../components/Footer.astro';

const lang = 'en';
const currentPath = '/en/cases/social-commerce-live-shopping';

const page = {
  title: 'ConnectingTheDots · Social Commerce & Live Shopping: TikTok Shop, Whatnot, eBay Live',
  description: 'Fast entry into social commerce and live shopping: TikTok Shop, Whatnot, eBay Live. We handle the market launch without strategy papers and without endless meetings.',
  hero: {
    eyebrow: 'Social Commerce & Live Shopping',
    title: 'TikTok Shop, Whatnot, eBay Live. Live in days, not months.',
    subtitle: 'Social commerce and live shopping are exploding right now. We get you on the platforms that are growing, fast and simple, without endless strategy papers and alignment rounds. Just do it.',
    cta: 'Book a free call',
  },
  platforms: {
    title: 'The platforms that are booming',
    items: [
      { icon: '🎵', name: 'TikTok Shop', desc: 'Sell directly in the app that dominates Gen Z and Millennials. Shoppable videos, LIVE shopping, and affiliate programs, all in one channel.', stat: '#1 fastest growing social commerce channel' },
      { icon: '🔴', name: 'Whatnot', desc: 'The leading live shopping platform for collectibles, fashion, beauty, and more. Auction + entertainment = higher basket sizes and loyal customers.', stat: 'Live shopping with up to 5x higher conversion' },
      { icon: '🛍️', name: 'eBay Live', desc: 'eBay brings live shopping to one of the world\'s largest commerce platforms. Activate existing customers and reach new audiences through interactive streams.', stat: 'Access to 135M active buyers' },
    ],
  },
  approach: {
    title: 'Our approach: Do it, don\'t just plan it',
    steps: [
      { icon: '⚡', title: 'Setup in days', text: 'Account setup, product listing, and onboarding: we handle everything operationally so you go live as fast as possible. No months-long IT project.' },
      { icon: '🎬', title: 'Start selling', text: 'Whether shoppable video on TikTok, live auction on Whatnot, or stream on eBay Live, we start with real sales and learn in the market.' },
      { icon: '📈', title: 'Scale what works', text: 'Data-driven optimization: what works gets scaled. New formats, larger reach, more channels, fast and without bureaucracy.' },
    ],
  },
  results: {
    title: 'Why social commerce now?',
    kpis: [
      { value: '$107B', label: 'Social commerce market 2025 (global)', icon: '🌍' },
      { value: '5x', label: 'Higher conversion in live shopping vs. traditional', icon: '🔥' },
      { value: '67%', label: 'Of Gen Z have purchased via social media', icon: '📱' },
    ],
    quote: 'CTD supported GenesysAI in entering the EU market. Within months, strong partnerships and scalable sales channels were established.',
    quoteAuthor: 'Andreas Skorski, Founder GenesysAI',
  },
  forWhom: {
    title: 'Who is this for?',
    items: [
      'Brands and retailers who want to open social commerce as a new sales channel',
      'Companies that want to test TikTok Shop, Whatnot, or eBay Live without months of preparation',
      'D2C brands looking to reach younger audiences through social platforms',
      'Marketplace sellers who want to expand their reach through live shopping',
    ],
  },
  whyCTD: {
    title: 'Why ConnectingTheDots?',
    items: [
      { icon: '🚀', title: 'Just do it', text: 'No strategy papers, no endless alignment rounds. We start directly and optimize based on real data.' },
      { icon: '🔗', title: 'Platform network', text: 'Direct contacts at TikTok Shop, Whatnot, and eBay Live. We know the people and the processes.' },
      { icon: '🛠️', title: 'Execution from one source', text: 'From account setup to content strategy to ongoing operations, everything from one source.' },
      { icon: '📊', title: '15 years experience', text: 'Growth, business development, and market entry across the DACH region and Europe, strategic and operational.' },
    ],
  },
};
---

<Layout
  title={page.title}
  description={page.description}
  lang={lang}
  currentPath={currentPath}
>
  <Header lang={lang} currentPath={currentPath} />
  <main>
    <!-- Hero -->
    <section class="relative bg-white pt-32 pb-20 px-4 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-accent/5 via-transparent to-accent/3"></div>
      <div class="max-w-4xl mx-auto relative z-10 text-center">
        <span class="inline-block text-xs uppercase tracking-[0.3em] text-accent font-semibold mb-4">{page.hero.eyebrow}</span>
        <h1 class="text-4xl lg:text-5xl font-bold leading-tight mb-6">{page.hero.title}</h1>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto mb-10 leading-relaxed">{page.hero.subtitle}</p>
        <a href="#contact" class="inline-flex items-center justify-center py-4 px-8 text-lg rounded-xl text-accent-foreground bg-accent shadow-[0_22px_48px_rgba(123,224,183,0.35)] transition-all hover:-translate-y-[2px] hover:shadow-[0_30px_58px_rgba(123,224,183,0.4)] active:scale-[0.98]">
          {page.hero.cta}
          <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
      </div>
    </section>

    <!-- Platforms -->
    <section class="bg-secondary py-20 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl lg:text-3xl font-bold text-center mb-14">{page.platforms.title}</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {page.platforms.items.map((platform) => (
            <div class="border border-accent/20 bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all hover:-translate-y-1">
              <div class="text-4xl mb-4">{platform.icon}</div>
              <h3 class="text-xl font-semibold mb-3">{platform.name}</h3>
              <p class="text-muted-foreground leading-relaxed mb-4">{platform.desc}</p>
              <span class="inline-block text-xs font-semibold text-accent bg-accent/10 px-3 py-1 rounded-full">{platform.stat}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Approach: 3 Steps -->
    <section class="bg-white py-20 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl lg:text-3xl font-bold text-center mb-14">{page.approach.title}</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {page.approach.steps.map((step) => (
            <div class="border border-accent/20 bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow">
              <div class="text-4xl mb-4">{step.icon}</div>
              <h3 class="text-xl font-semibold mb-3">{step.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{step.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Market Numbers -->
    <section class="bg-secondary py-20 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl lg:text-3xl font-bold text-center mb-14">{page.results.title}</h2>
        <div class="grid grid-cols-3 gap-6 mb-14">
          {page.results.kpis.map((kpi) => (
            <div class="border border-accent/20 bg-white/60 backdrop-blur rounded-2xl p-8 text-center shadow-sm">
              <div class="text-3xl mb-3">{kpi.icon}</div>
              <div class="text-3xl font-bold text-foreground mb-2">{kpi.value}</div>
              <div class="text-sm text-muted-foreground">{kpi.label}</div>
            </div>
          ))}
        </div>
        <div class="max-w-3xl mx-auto bg-white rounded-2xl p-8 shadow-sm border border-accent/10">
          <blockquote class="text-lg italic text-foreground leading-relaxed mb-4">"{page.results.quote}"</blockquote>
          <p class="text-sm text-accent font-semibold">{page.results.quoteAuthor}</p>
        </div>
      </div>
    </section>

    <!-- Why CTD -->
    <section class="bg-white py-20 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl lg:text-3xl font-bold text-center mb-14">{page.whyCTD.title}</h2>
        <div class="grid md:grid-cols-2 gap-8">
          {page.whyCTD.items.map((item) => (
            <div class="flex gap-4 p-6 bg-secondary/50 rounded-2xl">
              <div class="text-3xl flex-shrink-0">{item.icon}</div>
              <div>
                <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
                <p class="text-muted-foreground leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- For Whom -->
    <section class="bg-secondary py-16 px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl lg:text-3xl font-bold mb-8">{page.forWhom.title}</h2>
        <ul class="space-y-4">
          {page.forWhom.items.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-2 w-2 rounded-full bg-accent flex-shrink-0"></span>
              <span class="text-muted-foreground leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Lead Form -->
    <LeadForm lang={lang} />
  </main>
  <Footer lang={lang} currentPath={currentPath} />
</Layout>

<style>
  main { min-height: 100vh; }
</style>
