---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import LeadForm from '../../components/LeadForm.astro';
import Footer from '../../components/Footer.astro';

const lang = 'en';
const currentPath = '/en/tiktok-shop-partner';

const page = {
  title: 'TikTok Shop Partner (TSP): full-service network · ConnectingTheDots',
  description: 'Official TikTok Shop Partner network: commerce, brand and technology from a single point of contact. One agreement, three specialists – setup, LIVE Shopping and operations for brands and retailers in DE/EU.',
  hero: {
    eyebrow: 'TikTok Shop Partner (TSP)',
    title: 'Your TikTok Shop Partner: commerce, brand and technology from a single point of contact.',
    subtitle: 'As part of a registered TikTok Shop Partner network we bring brands and retailers full-service onto TikTok Shop – one point of contact, three specialists, from strategy and setup to day-to-day operations.',
    cta: 'Request a partner call',
  },
  partners: {
    title: 'One partner entity, three specialist strengths',
    intro: 'Cadan Software GmbH is the registered TikTok Shop Partner. Delivery runs through a tight network of specialists, so sellers get commerce, brand and technology from a single point of contact.',
    items: [
      { tag: 'TSP & Technology', name: 'Cadan Software GmbH', desc: 'The contracting TikTok Shop Partner entity. Brings the AI/SaaS and data backbone for analytics, automation and reporting.', icon: '⚙️' },
      { tag: 'Commerce Operations', name: 'ConnectingTheDots', desc: 'Runs the commercial engine: marketplace and TikTok Shop strategy, onboarding, creator & affiliate, ads and day-to-day operations.', icon: '🚀' },
      { tag: 'Brand & Creative', name: 'Make Branding', desc: 'Branding, webdesign, content and online marketing. Turns the shop into a brand that converts on TikTok.', icon: '🎨', href: 'https://makebranding.de' },
    ],
  },
  glance: {
    title: 'Commerce, brand and technology, combined',
    intro: 'The network pairs a registered GmbH with 15+ years of hands-on commerce experience and a creative agency, covering everything a TikTok Shop seller needs without juggling multiple vendors.',
    stats: [
      { value: '15+', label: 'Years of e-commerce & go-to-market experience' },
      { value: '50+', label: 'Brands supported across channels' },
      { value: '3', label: 'Specialist partners under one TSP entity' },
    ],
    bafa: 'BAFA-listed consultancy in the network, eligible for German public funding of advisory services.',
  },
  capabilities: {
    title: 'Everything a TikTok Shop seller needs',
    intro: 'Full-service across the network – commerce (CTD), brand (Make) and technology (Cadan).',
    items: [
      { icon: '🧭', title: 'Marketplace Strategy', text: 'Channel mix, positioning & roadmap' },
      { icon: '✅', title: 'TikTok Shop Onboarding', text: 'Setup, certification & go-live' },
      { icon: '🛠️', title: 'Shop Operations', text: 'Listings, pricing & day-to-day' },
      { icon: '🎨', title: 'Brand & Creative Direction', text: 'Identity, art direction & assets' },
      { icon: '🖥️', title: 'Content & Webdesign', text: 'Storefront, content & landing pages' },
      { icon: '📣', title: 'Retail Media & Ads', text: 'Paid campaigns & ROAS' },
      { icon: '🤝', title: 'Creator & Affiliate', text: 'Sourcing, programs & activation' },
      { icon: '📊', title: 'Reporting & AI Analytics', text: 'KPIs, dashboards & insight' },
      { icon: '🔗', title: 'Shopify & Integrations', text: 'Product sync & systems' },
    ],
  },
  fit: {
    title: 'Why we fit TikTok Shop',
    items: [
      { icon: '🔴', title: 'Native to the channel', text: 'We operate TikTok Shop, marketplaces and Shopify daily, not as theory but as live merchant operations.' },
      { icon: '⚡', title: 'Direct partner access', text: 'A direct line into the TikTok Shop team to unblock onboarding and issues fast.' },
      { icon: '💡', title: 'Brand that converts', text: 'Make Branding builds the creative and content that makes products sell on TikTok.' },
      { icon: '💎', title: 'Depth in strategic verticals', text: 'Category experience in jewelry, beauty, premium fashion and home & living – all high-conversion TikTok verticals.' },
    ],
  },
  caseStudy: {
    eyebrow: 'TikTok Shop Case Study',
    title: 'Shine&Love by BrautSchön: live in 4 weeks',
    meta: '925 silver jewelry, bridal & hair accessories · Shopify · Jewelry & bridal',
    delivered: [
      'TikTok Shop DE market analysis & go-to-market strategy',
      'Shopify x TikTok Shop integration (product data sync)',
      'Creator & affiliate program setup and sourcing',
      'Content strategy and campaign planning',
      'Cost model with break-even and scaling roadmap',
    ],
    quote: 'As a jewelry brand on Shopify, TikTok Shop was completely new territory for us. Maximilian got our products live and sellable in just four weeks and solved legacy issues that would not have been possible without his direct line to TikTok. If you want to sell on TikTok Shop as a brand, this is the right place.',
    quoteAuthor: 'Cathrin Hesping, Owner, BrautSchön GmbH / Shine&Love',
  },
  why: {
    title: 'What makes this network a strong TSP',
    items: [
      { icon: '🏃', title: 'Operators, not just advisors', text: 'We run live TikTok Shop, marketplace and Shopify operations day-to-day.' },
      { icon: '🔓', title: 'Direct TikTok partner access', text: 'A direct line into the TikTok Shop team to unblock onboarding and issues fast.' },
      { icon: '🧩', title: 'Commerce + brand + tech', text: 'One agreement covers strategy, operations, creative and the data backbone.' },
      { icon: '🏬', title: 'Marketplace & vertical depth', text: 'Years inside the Zalando/Tradebyte ecosystem and in premium jewelry, beauty and home & living.' },
      { icon: '🤖', title: 'AI-supported analysis', text: 'Market and sales data analyzed with modern AI, GDPR-compliant and fast.' },
      { icon: '🇩🇪', title: 'BAFA-listed network', text: 'German public funding available for advisory engagements.' },
    ],
  },
  faq: {
    title: 'Frequently asked questions about the TikTok Shop partnership',
    items: [
      { q: 'What is a TikTok Shop Partner (TSP)?', a: 'A TikTok Shop Partner (TSP) is a TikTok-recognized service provider that helps brands and retailers build and run their TikTok Shop – from onboarding and shop management to creators, ads and scaling. Our network combines commerce, brand and technology under one registered partner entity.' },
      { q: 'Who is the contracting partner entity?', a: 'The contracting party is Cadan Software GmbH as the registered TikTok Shop Partner and technology backbone. The commercial delivery is handled by ConnectingTheDots, brand and creative come from Make Branding – all through a single point of contact.' },
      { q: 'What services does the network cover?', a: 'Full-service: marketplace and TikTok Shop strategy, onboarding and certification, shop operations, creator & affiliate, retail media & ads, brand & creative, content & webdesign, reporting with AI analytics, and Shopify and system integrations.' },
      { q: 'Which markets and categories?', a: 'Focus on Germany and the EU. We have particular depth in the strategic verticals jewelry, beauty, premium fashion and home & living – all high-conversion categories on TikTok – but work across categories.' },
      { q: 'Is BAFA funding possible?', a: 'The network includes a BAFA-listed consultancy. Advisory services may therefore be eligible for German public funding under the applicable conditions. We clarify concrete eligibility in the intro call.' },
      { q: 'How fast can a shop go live?', a: 'Once verification and the product catalog are in place, first shops are ready to sell within a few weeks. In our Shine&Love reference the shop was live in four weeks – including Shopify integration, creator setup and campaign planning.' },
    ],
  },
  related: {
    title: 'Also of interest',
    links: [
      { href: '/en/tiktok-shop', label: 'Sell on TikTok Shop: setup, LIVE Shopping & operations' },
      { href: '/en/cases/social-commerce-live-shopping', label: 'Social Commerce & Live Shopping at a glance' },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": page.faq.items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "TikTok Shop Partner (TSP) – Full-Service Operations",
  "name": "TikTok Shop Partner network for brands and retailers",
  "description": page.description,
  "provider": { "@type": "Organization", "name": "ConnectingTheDots", "url": "https://connectingthe.de" },
  "areaServed": { "@type": "Country", "name": ["DE", "AT", "CH"] },
  "url": "https://connectingthe.de/en/tiktok-shop-partner",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://connectingthe.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "TikTok Shop Partner", "item": "https://connectingthe.de/en/tiktok-shop-partner" },
  ],
};
---

<Layout
  title={page.title}
  description={page.description}
  lang={lang}
  currentPath={currentPath}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Header lang={lang} currentPath={currentPath} />
  <main>
    <!-- Hero -->
    <section class="relative bg-white pt-32 pb-20 px-4 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-accent/5 via-transparent to-accent/3"></div>
      <div class="max-w-4xl mx-auto relative z-10 text-center">
        <span class="inline-block text-xs uppercase tracking-[0.3em] text-accent font-semibold mb-4">{page.hero.eyebrow}</span>
        <h1 class="text-4xl lg:text-5xl font-bold leading-tight mb-6">{page.hero.title}</h1>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto mb-8 leading-relaxed">{page.hero.subtitle}</p>
        <a href="#contact" class="inline-flex items-center justify-center py-4 px-8 text-lg rounded-xl text-accent-foreground bg-accent shadow-[0_22px_48px_rgba(123,224,183,0.35)] transition-all hover:-translate-y-[2px] hover:shadow-[0_30px_58px_rgba(123,224,183,0.4)] active:scale-[0.98]">
          {page.hero.cta}
          <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
      </div>
    </section>

    <!-- The partnership -->
    <section class="bg-secondary py-20 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl lg:text-3xl font-bold text-center mb-4">{page.partners.title}</h2>
        <p class="text-lg text-muted-foreground leading-relaxed mb-14 max-w-3xl mx-auto text-center">{page.partners.intro}</p>
        <div class="grid md:grid-cols-3 gap-8">
          {page.partners.items.map((p) => (
            <div class="border border-accent/20 bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all hover:-translate-y-1">
              <div class="text-4xl mb-4">{p.icon}</div>
              <span class="inline-block text-xs uppercase tracking-[0.2em] text-accent font-semibold mb-2">{p.tag}</span>
              <h3 class="text-xl font-semibold mb-3">{p.name}</h3>
              <p class="text-muted-foreground leading-relaxed">{p.desc}</p>
              {p.href && (
                <a href={p.href} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent hover:underline">
                  makebranding.de
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- At a glance + stats -->
    <section class="bg-white py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl lg:text-3xl font-bold mb-6">{page.glance.title}</h2>
        <p class="text-lg text-muted-foreground leading-relaxed mb-14 max-w-3xl mx-auto">{page.glance.intro}</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
          {page.glance.stats.map((s) => (
            <div class="border border-accent/20 bg-secondary/40 rounded-2xl p-8 text-center shadow-sm">
              <div class="text-4xl font-bold text-foreground mb-2">{s.value}</div>
              <div class="text-sm text-muted-foreground">{s.label}</div>
            </div>
          ))}
        </div>
        <div class="max-w-2xl mx-auto bg-accent/10 border border-accent/20 rounded-2xl p-5 text-sm text-foreground font-medium">
          🇩🇪 {page.glance.bafa}
        </div>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="bg-secondary py-20 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl lg:text-3xl font-bold text-center mb-4">{page.capabilities.title}</h2>
        <p class="text-muted-foreground text-center mb-14 max-w-2xl mx-auto">{page.capabilities.intro}</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {page.capabilities.items.map((c) => (
            <div class="border border-accent/20 bg-white rounded-2xl p-6 shadow-sm">
              <div class="text-3xl mb-3">{c.icon}</div>
              <h3 class="text-base font-semibold mb-1">{c.title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{c.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why we fit -->
    <section class="bg-white py-20 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl lg:text-3xl font-bold text-center mb-14">{page.fit.title}</h2>
        <div class="grid md:grid-cols-2 gap-8">
          {page.fit.items.map((item) => (
            <div class="flex gap-4 p-6 bg-secondary/50 rounded-2xl">
              <div class="text-3xl flex-shrink-0">{item.icon}</div>
              <div>
                <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
                <p class="text-muted-foreground leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Case Study -->
    <section class="bg-secondary py-20 px-4">
      <div class="max-w-4xl mx-auto">
        <span class="block text-center text-xs uppercase tracking-[0.3em] text-accent font-semibold mb-3">{page.caseStudy.eyebrow}</span>
        <h2 class="text-2xl lg:text-3xl font-bold text-center mb-2">{page.caseStudy.title}</h2>
        <p class="text-sm text-muted-foreground text-center mb-12">{page.caseStudy.meta}</p>
        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-accent/10">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-accent mb-4">What the network delivered</h3>
            <ul class="space-y-3">
              {page.caseStudy.delivered.map((d) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 rounded-full bg-accent flex-shrink-0"></span>
                  <span class="text-muted-foreground leading-relaxed text-sm">{d}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-accent">
              <span class="bg-accent/10 px-3 py-1 rounded-full">Setup → Go-Live → Scale</span>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-accent/10">
            <blockquote class="text-lg italic text-foreground leading-relaxed mb-4">“{page.caseStudy.quote}”</blockquote>
            <p class="text-sm text-accent font-semibold">{page.caseStudy.quoteAuthor}</p>
            <p class="text-xs text-muted-foreground mt-2">Reference used with permission.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why partner with us -->
    <section class="bg-white py-20 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl lg:text-3xl font-bold text-center mb-14">{page.why.title}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {page.why.items.map((item) => (
            <div class="border border-accent/20 bg-secondary/40 rounded-2xl p-6">
              <div class="text-3xl mb-3">{item.icon}</div>
              <h3 class="text-base font-semibold mb-2">{item.title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-secondary py-20 px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl lg:text-3xl font-bold text-center mb-12">{page.faq.title}</h2>
        <div class="space-y-4">
          {page.faq.items.map((item) => (
            <details class="group border border-accent/20 rounded-2xl bg-white p-6 [&_summary]:cursor-pointer">
              <summary class="flex items-center justify-between gap-4 font-semibold text-foreground list-none">
                <span>{item.q}</span>
                <svg class="h-5 w-5 flex-shrink-0 text-accent transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </summary>
              <p class="text-muted-foreground leading-relaxed mt-4">{item.a}</p>
            </details>
          ))}
        </div>

        <div class="mt-14 text-center">
          <h2 class="text-lg font-semibold mb-4">{page.related.title}</h2>
          <div class="flex flex-wrap justify-center gap-3">
            {page.related.links.map((link) => (
              <a href={link.href} class="inline-flex items-center text-sm text-accent font-medium hover:underline">
                {link.label}
                <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Lead Form -->
    <LeadForm lang={lang} />
  </main>
  <Footer lang={lang} currentPath={currentPath} />
</Layout>

<style>
  main { min-height: 100vh; }
  details summary::-webkit-details-marker { display: none; }
</style>
