---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import HeroSection from '../../components/HeroSection.astro';
import CustomerReferences from '../../components/CustomerReferences.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import ServicesNetwork from '../../components/ServicesNetwork.astro';
import ReferencesSlider from '../../components/ReferencesSlider.astro';
import LeadForm from '../../components/LeadForm.astro';
import Footer from '../../components/Footer.astro';

const lang = 'en';
const currentPath = '/en';
---

<Layout 
	title="ConnectingTheDots · New markets for startups and SMEs"
	description="We help startups and SMEs sell where demand actually is: marketplaces, TikTok Shop, Whatnot, eBay Live. Try it, measure it, grow it."
	lang={lang}
	currentPath={currentPath}
	image="/videos/ConnectingTheDots_HowItWorks_EN_poster.png"
>
	<Header lang={lang} currentPath={currentPath} />
	<main>
		<HeroSection lang={lang} />
		<a href="/en/ki-check" class="block bg-accent/10 border-y border-accent/20 hover:bg-accent/15 transition-colors">
			<div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center text-sm">
				<span class="text-foreground">🔎 <strong class="font-semibold">New:</strong> Free AI potential analysis – where your shop loses time and revenue.</span>
				<span class="font-semibold text-accent inline-flex items-center gap-1">Learn more
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
				</span>
			</div>
		</a>
		<HowItWorks lang={lang} />
		<ServicesNetwork lang={lang} />
		<CustomerReferences lang={lang} />
		<ReferencesSlider lang={lang} />
		<LeadForm lang={lang} />
	</main>
	<Footer lang={lang} currentPath={currentPath} />
</Layout>

<style>
	main {
		min-height: 100vh;
	}
</style>

